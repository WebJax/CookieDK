# === Privacy Policy ===

msgid "Cookiepolitik"
msgstr "Cookiepolitik"

msgid "%s bruger cookies til at forbedre din oplevelse på vores website. Denne side forklarer, hvilke cookies vi bruger, og hvad de bruges til."
msgstr "%s bruger cookies til at forbedre din oplevelse på vores website. Denne side forklarer, hvilke cookies vi bruger, og hvad de bruges til."

msgid "Hvad er cookies?"
msgstr "Hvad er cookies?"

msgid "Cookies er små tekstfiler, der gemmes på din computer eller enhed, når du besøger et website. De bruges til at huske dine præferencer, holde dig logget ind og indsamle anonyme statistikker om brug af websitet."
msgstr "Cookies er små tekstfiler, der gemmes på din computer eller enhed, når du besøger et website. De bruges til at huske dine præferencer, holde dig logget ind og indsamle anonyme statistikker om brug af websitet."

msgid "Når du besøger vores website for første gang, vises et cookie-banner, hvor du kan vælge, hvilke kategorier af cookies du accepterer. Du kan til enhver tid ændre dine præferencer ved at klikke på cookie-indstillingerne."
msgstr "Når du besøger vores website for første gang, vises et cookie-banner, hvor du kan vælge, hvilke kategorier af cookies du accepterer. Du kan til enhver tid ændre dine præferencer ved at klikke på cookie-indstillingerne."

msgid "Nødvendige cookies"
msgstr "Nødvendige cookies"

msgid "Disse cookies er nødvendige for at websitet fungerer korrekt. De kan ikke deaktiveres. De bruges typisk til at huske dine cookie-præferencer, holde din session aktiv og sikre grundlæggende websitfunktioner."
msgstr "Disse cookies er nødvendige for at websitet fungerer korrekt. De kan ikke deaktiveres. De bruges typisk til at huske dine cookie-præferencer, holde din session aktiv og sikre grundlæggende websitfunktioner."

msgid "Retsgrundlag: Legitim interesse (artikel 6(1)(f) GDPR) – nødvendig for webstedets funktion."
msgstr "Retsgrundlag: Legitim interesse (artikel 6(1)(f) GDPR) – nødvendig for webstedets funktion."

msgid "Funktionelle cookies"
msgstr "Funktionelle cookies"

msgid "Disse cookies giver websitet mulighed for at huske valg, du træffer (f.eks. dit brugernavn, sprog eller region), og tilbyde forbedrede, mere personlige funktioner."
msgstr "Disse cookies giver websitet mulighed for at huske valg, du træffer (f.eks. dit brugernavn, sprog eller region), og tilbyde forbedrede, mere personlige funktioner."

msgid "Retsgrundlag: Samtykke (artikel 6(1)(a) GDPR)."
msgstr "Retsgrundlag: Samtykke (artikel 6(1)(a) GDPR)."

msgid "Analytiske cookies"
msgstr "Analytiske cookies"

msgid "Disse cookies hjælper os med at forstå, hvordan besøgende interagerer med websitet, ved at indsamle og rapportere informationer anonymt. De hjælper os med at forbedre websitets indhold og brugervenlighed."
msgstr "Disse cookies hjælper os med at forstå, hvordan besøgende interagerer med websitet, ved at indsamle og rapportere informationer anonymt. De hjælper os med at forbedre websitets indhold og brugervenlighed."

msgid "Marketing-cookies"
msgstr "Marketing-cookies"

msgid "Disse cookies bruges til at vise dig relevante annoncer baseret på dine interesser. De bruges til at begrænse, hvor mange gange du ser en annonce, og til at måle effektiviteten af annoncekampagner."
msgstr "Disse cookies bruges til at vise dig relevante annoncer baseret på dine interesser. De bruges til at begrænse, hvor mange gange du ser en annonce, og til at måle effektiviteten af annoncekampagner."

msgid "Cookie"
msgstr "Cookie"

msgid "Udbyder"
msgstr "Udbyder"

msgid "Formål"
msgstr "Formål"

msgid "Levetid"
msgstr "Levetid"

msgid "Opbevaring og sletning"
msgstr "Opbevaring og sletning"

msgid "Dit samtykke gemmes i op til 365 dage. IP-adresser i vores samtykke-log anonymiseres automatisk efter 30 dage."
msgstr "Dit samtykke gemmes i op til 365 dage. IP-adresser i vores samtykke-log anonymiseres automatisk efter 30 dage."

msgid "Dine rettigheder"
msgstr "Dine rettigheder"

msgid "Ret til indsigt – Du kan til enhver tid anmode om en kopi af de data, vi har registreret om dig."
msgstr "Ret til indsigt – Du kan til enhver tid anmode om en kopi af de data, vi har registreret om dig."

msgid "Ret til sletning – Du kan anmode om sletning af dine samtykke-data (\"retten til at blive glemt\")."
msgstr "Ret til sletning – Du kan anmode om sletning af dine samtykke-data (\"retten til at blive glemt\")."

msgid "Ret til at trække samtykke tilbage – Du kan til enhver tid trække dit samtykke tilbage uden begrundelse."
msgstr "Ret til at trække samtykke tilbage – Du kan til enhver tid trække dit samtykke tilbage uden begrundelse."

msgid "Du har ret til at klage til Datatilsynet, hvis du mener, at behandlingen af dine personoplysninger er i strid med GDPR. Læs mere på %s."
msgstr "Du har ret til at klage til Datatilsynet, hvis du mener, at behandlingen af dine personoplysninger er i strid med GDPR. Læs mere på %s."

msgid "Disse cookies er nødvendige for at websitet fungerer"
msgstr "Disse cookies er nødvendige for at websitet fungerer"

msgid "Disse cookies husker dine præferencer"
msgstr "Disse cookies husker dine præferencer"

msgid "Disse cookies hjælper os med at forstå hvordan du bruger websitet"
msgstr "Disse cookies hjælper os med at forstå hvordan du bruger websitet"

