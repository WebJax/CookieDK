{
  "name": "webjax/cookiedk",
  "description": "GDPR-compliant cookie banner plugin for WordPress",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "phpstan/phpstan": "^2.2",
    "php-stubs/wordpress-stubs": "^7.0",
    "squizlabs/php_codesniffer": "^3.10",
    "wp-coding-standards/wpcs": "^3.1",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
  },
  "autoload": {
    "classmap": [
      "includes/",
      "admin/",
      "public/"
    ]
  },
  "scripts": {
    "test": "phpunit -c tests/phpunit.xml.dist",
    "test:coverage": "phpunit -c tests/phpunit.xml.dist --coverage-text",
    "phpstan": "phpstan analyse --configuration=.phpstan.neon",
    "phpcs": "phpcs --standard=WordPress ./cookiedk.php ./includes ./admin ./public",
    "lint": "find . -type f -name '*.php' -not -path './vendor/*' -print0 | xargs -0 -n1 php -l"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
